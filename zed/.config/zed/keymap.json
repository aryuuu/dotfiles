[
  {
    "bindings": {
      "alt-down": ["workspace::SendKeystrokes", "down down down down"],
      "cmd-alt-c": [
        "workspace::SendKeystrokes",
        "cmd-shift-p copy relative path enter"
      ],
      "cmd-alt-r": ["workspace::SendKeystrokes", "cmd-p README enter"],
      "ctrl-right": "editor::SelectLargerSyntaxNode",
      "ctrl-left": "editor::SelectSmallerSyntaxNode",
      "ctrl->": "editor::Indent",
      "ctrl-k ctrl-o": "projects::OpenRecent"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": ["workspace::SendKeystrokes", "escape"]
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space f": "file_finder::Toggle",
      "space e": "workspace::ToggleLeftDock",
      "space w": "workspace::Save",
      "space x": "pane::CloseActiveItem",
      "space q": ["workspace::SendKeystrokes", ": q enter"],
      "space l j": "editor::GoToDiagnostic",
      "space l k": "editor::GoToPrevDiagnostic",
      "space g j": "editor::GoToHunk",
      "space g k": "editor::GoToPrevHunk",
      "space t p": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-k": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Project",
    "bindings": {
      "space e": "workspace::CloseAllDocks"
    }
  }
]
