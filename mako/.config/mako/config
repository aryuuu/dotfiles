# font=Cozette 11
font=scientifica 10
format=<b>%a ⏵</b> %s\n%b
sort=-time
output=DP-2
layer=overlay
# anchor=bottom-center

# background-color=#2e3440
width=300
height=110
margin=5
padding=0,5,10
border-size=2
# border-color=#88c0d0
background-color=#1e1e2e
border-color=#89b4fa
border-radius=10
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1

