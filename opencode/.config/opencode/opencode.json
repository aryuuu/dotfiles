{
  "$schema": "https://opencode.ai/config.json",
  "model": "kiro/claude-opus-4-6",
  "autoupdate": "notify",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "jj diff *": "allow",
      "ls *": "allow",
      "rm *": "ask",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "aws * describe-*": "allow",
      "aws * list-*": "allow",
      "aws * get-*": "allow",
      "gh pr *": "allow",
      "gh api *": "allow",
      "cat *": "allow"
    },
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "plugin": [
    "oh-my-opencode@3.0.0-beta.16"
  ]
}
